[
  {
    "type": "separator",
    "label": "ROUNDNESS &  CORNERS"
  },
  {
    "type": "string",
    "property": "arc-squircle",
    "defaultValue": "1.1",
    "placeholder": "1.1",
    "label": "*Squircle* roundness (~lower value = rounder; use a value between 0.8 and 2~)."
  },
  {
    "type": "checkbox",
    "property": "layout.css.corner-shape.enabled",
    "label": "Use *squircle* corners (~disable to use plain `px` border radius below~).",
    "defaultValue": false
  },
  {
    "type": "string",
    "label": "*UI* corner radius — toolbar, tabs, menus (~use a value between 0px and 25px~).",
    "property": "arc-border-radius",
    "defaultValue": "12px",
    "placeholder": "12px"
  },
  {
    "type": "string",
    "label": "*Web page* corner radius — the content view (~use a value between 0px and 25px~).",
    "property": "mod.zenmodme.webview-radius",
    "defaultValue": "12px",
    "placeholder": "12px"
  },
  {
    "type": "string",
    "value": "number",
    "label": "*Window margin* between the web page and the browser edge (~use a value between 0 and 12~).",
    "property": "zen.theme.content-element-separation"
  },
  {
    "type": "separator",
    "label": "PICTURE-IN-PICTURE"
  },
  {
    "property": "mod.zenmodme.pip.enabled",
    "label": "Enable *custom* Picture-in-Picture styling.",
    "type": "checkbox",
    "defaultValue": true
  },
  {
    "property": "mod.zenmodme.pip.radius",
    "label": "Picture-in-Picture *corner radius*.",
    "type": "string",
    "defaultValue": "12px",
    "placeholder": "12px"
  },
  {
    "type": "separator",
    "label": "TABS &  ICONS"
  },
  {
    "type": "checkbox",
    "label": "Show the *Arc menu icon* on the hamburger button.",
    "property": "arc-menu-icon",
    "defaultValue": false
  },
  {
    "type": "checkbox",
    "label": "*Fade* unloaded tabs.",
    "property": "browser.tabs.fadeOutUnloadedTabs",
    "defaultValue": false
  },
  {
    "type": "checkbox",
    "label": "*Grayscale* unloaded tabs (~requires fade to be enabled above~).",
    "property": "arc-grayscale-unloaded-tabs",
    "defaultValue": false
  }
